# Register a native/public client app in Microsoft Entra ID. Do not commit your real .env.
CLIENT_ID=
USER_EMAIL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Defaults are safe: reply and digest messages are created only as Outlook drafts.
SCHEDULES=06:00,12:00,15:00
LOOKBACK_HOURS=24
DIGEST_MODE=draft
DIGEST_RECIPIENTS=
EXCLUDED_SENDERS=
MAX_HISTORY_MESSAGES=40

# Draft polish. Use \n for a multi-line signature.
DRAFT_TONE=concise, professional, and helpful
DRAFT_GREETING=Hi
DRAFT_CLOSING=Best,
DRAFT_SIGNATURE=

# Replies are never drafted for common automated sender patterns or these explicit addresses/domains.
NO_REPLY_SENDERS=
NO_REPLY_DOMAINS=

# Folder learning only suggests destinations with Outlook categories; it never moves mail.
FOLDER_SUGGESTIONS_ENABLED=true
FOLDER_HISTORY_PER_FOLDER=50
FOLDER_MIN_EXAMPLES=2
FOLDER_MIN_CONFIDENCE=0.80
